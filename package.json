{
  "name": "kanban-cloudflare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "pages:dev": "wrangler pages dev ./dist",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types tests/position.test.mjs && node --experimental-strip-types tests/migration.test.mjs",
    "db:migrate:local": "wrangler d1 execute kanban-db --local --file=./migrations/0000_init.sql && node scripts/migrate-all-local.mjs",
    "db:migrate:remote": "wrangler d1 execute kanban-db --remote --file=./migrations/0001_workspaces.sql",
    "db:migrate:local:v2": "node --experimental-strip-types scripts/migrate-workspaces-local.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  }
}
